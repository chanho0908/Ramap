{
  "name": "ramap",
  "version": "0.1.0",
  "private": true,
  "description": "라멘 오타쿠를 위한 전국 라멘 지도 서비스",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:mobile": "turbo run dev --filter=mobile",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:mobile": "turbo run build --filter=mobile",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "crawl:shops": "tsx scripts/crawling/crawl-shops.ts",
    "crawl:shops:strict": "tsx scripts/crawling/crawl-shops.ts --strict",
    "crawl:shops:dry-run": "tsx scripts/crawling/crawl-shops.ts --dry-run",
    "crawl:instagram": "tsx scripts/crawling/crawl-instagram-info.ts",
    "crawl:instagram:dry-run": "tsx scripts/crawling/crawl-instagram-info.ts --dry-run",
    "test:instagram-crawler": "tsx scripts/crawling/test-instagram-crawler.ts",
    "update:descriptions": "tsx scripts/crawling/update-missing-descriptions.ts",
    "update:descriptions:dry-run": "tsx scripts/crawling/update-missing-descriptions.ts --dry-run",
    "clean:kakaomap-prefix": "tsx scripts/crawling/clean-kakaomap-prefix.ts",
    "clean:kakaomap-prefix:dry-run": "tsx scripts/crawling/clean-kakaomap-prefix.ts --dry-run",
    "delete:non-ramen": "tsx scripts/crawling/delete-non-ramen-shops.ts",
    "delete:non-ramen:dry-run": "tsx scripts/crawling/delete-non-ramen-shops.ts --dry-run",
    "analyze:non-ramen": "tsx scripts/crawling/analyze-non-ramen-shops.ts",
    "analyze:non-ramen:delete": "tsx scripts/crawling/analyze-non-ramen-shops.ts --delete --dry-run",
    "analyze:non-ramen:delete:confirm": "tsx scripts/crawling/analyze-non-ramen-shops.ts --delete --confirm",
    "classify:menus": "tsx scripts/crawling/apply-menu-classification.ts",
    "classify:menus:dry-run": "tsx scripts/crawling/apply-menu-classification.ts --dry-run"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "turbo": "^1.11.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.18.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "puppeteer": "^25.1.0",
    "tsx": "^4.22.4"
  }
}
